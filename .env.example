# ==============================================================================
# Graphify Local Server 2.0 -- Environment Configuration
# ==============================================================================

# Port to bind the server on host
PORT=28848

# Host workspace directory to mount into Docker (/app/workspaces)
# Point this to your parent projects/codebases folder so Docker can access and index them.
# Windows Example: HOST_WORKSPACE_DIR=D:/projects
# Linux/macOS Example: HOST_WORKSPACE_DIR=/home/user/projects
HOST_WORKSPACE_DIR=./workspaces

# Internal storage directories (inside container)
GRAPHIFY_DATA_DIR=/app/data
GRAPHIFY_STATIC_DIR=/app/static
GRAPHIFY_VIZ_NODE_LIMIT=50000

# Optional Security configuration
# GRAPHIFY_ENV=local # or production
# GRAPHIFY_API_KEY=your-secret-api-key-here
